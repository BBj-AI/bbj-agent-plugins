{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bbj-check.sh\"",
            "timeout": 30,
            "statusMessage": "BBj compile-only check"
          }
        ]
      }
    ]
  }
}
