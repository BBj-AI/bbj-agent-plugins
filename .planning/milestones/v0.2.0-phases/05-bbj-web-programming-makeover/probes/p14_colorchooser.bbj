declare auto BBjSysGui sysgui!
declare auto BBjTopLevelWindow win!
sysgui! = BBjAPI().openSysGui("X0")
win! = sysgui!.addWindow("t", $00100083$)
declare auto BBjColorChooser chooser!
chooser! = win!.addColorChooser()
chooser!.putClientProperty("components", "hue, saturation, lightness")
s! = chooser!.getClientProperty("saturation")
